<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="807.0" prefWidth="944.0" styleClass="root" stylesheets="@css/simulatorView.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="car.app.CarSimulatorController">

    <left>
        <VBox prefWidth="404.0" styleClass="left-panel">

            <Pane prefHeight="203.0" styleClass="panel">
                <Label layoutY="7.0" styleClass="section-name" text="CAR" />

                <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="Brand" />
                <Label fx:id="brandLabel" layoutX="11.0" layoutY="53.0" styleClass="label-value" />

                <Label layoutX="142.0" layoutY="33.0" styleClass="label-header" text="Model" />
                <Label fx:id="modelLabel" layoutX="139.0" layoutY="53.0" styleClass="label-value" />

                <Label layoutX="11.0" layoutY="83.0" styleClass="label-header" text="Plate" />
                <Label fx:id="licensePlateLabel" layoutX="11.0" layoutY="103.0" styleClass="label-value" />

                <Label layoutX="142.0" layoutY="83.0" styleClass="label-header" text="Weight" />
                <Label fx:id="carWeightLabel" layoutX="139.0" layoutY="103.0" styleClass="label-value" />

                <HBox layoutX="14.0" layoutY="133.0" spacing="8" styleClass="controls-box">
                    <ToggleButton fx:id="startCarButton" onAction="#startCar" styleClass="buttonOne" text="▶ START" />
                    <ToggleButton fx:id="stopCarButton" onAction="#stopCar" styleClass="buttonTwo" text="■ STOP">
                        <toggleGroup>
                            <ToggleGroup fx:id="carStateGroup" />
                        </toggleGroup>
                    </ToggleButton>
                </HBox>
            </Pane>

            <Pane prefHeight="243.0" styleClass="panel">
                <Label layoutX="7.0" layoutY="2.0" styleClass="section-name" text="ENGINE" />

                <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="Name" />
                <Label fx:id="engineNameLabel" layoutX="11.0" layoutY="53.0" styleClass="label-value" />

                <Label layoutX="142.0" layoutY="33.0" styleClass="label-header" text="Price" />
                <Label fx:id="enginePriceLabel" layoutX="139.0" layoutY="53.0" styleClass="label-value" />

                <Label layoutX="11.0" layoutY="83.0" styleClass="label-header" text="Weight" />
                <Label fx:id="engineWeightLabel" layoutX="11.0" layoutY="103.0" styleClass="label-value" />

                <VBox alignment="CENTER" layoutX="142.0" layoutY="103.0" spacing="2">
                    <Label fx:id="currentRpmLabel" styleClass="parameters" />
                    <Label styleClass="rpm-label" text="RPM" />
                </VBox>

                <Label layoutX="312.0" layoutY="17.0" styleClass="label-header" text="MAX:" />
                <Label fx:id="maxRpmLabel" layoutX="345.0" layoutY="17.0" styleClass="label-value" />

                <HBox layoutX="14.0" layoutY="173.0" spacing="8" styleClass="controls-box">
                    <Button fx:id="increaseRpmButton" onAction="#increaseRpm" styleClass="buttonOne" text="▲ INCREASE" />
                    <Button fx:id="decreaseRpmButton" onAction="#decreaseRpm" styleClass="buttonTwo" text="▼ DECREASE" />
                </HBox>
            </Pane>

            <Pane prefHeight="185.0" prefWidth="402.0" styleClass="panel">
                <Label layoutX="7.0" layoutY="2.0" styleClass="section-name" text="GEAR BOX" />

                <Label layoutX="71.0" layoutY="32.0" styleClass="label-header" text="NAME" />
                <Label fx:id="gearBoxNameLabel" layoutX="71.0" layoutY="52.0" styleClass="label-value" />

                <Label layoutX="227.0" layoutY="55.0" styleClass="label-header" text="PRICE" />
                <Label fx:id="gearBoxPriceLabel" layoutX="227.0" layoutY="75.0" styleClass="label-value" />

                <Label layoutX="71.0" layoutY="83.0" styleClass="label-header" text="WEIGHT" />
                <Label fx:id="gearBoxWeightLabel" layoutX="71.0" layoutY="103.0" styleClass="label-value" />

                <Label layoutX="322.0" layoutY="17.0" styleClass="label-header" text="GEARS" />
                <Label fx:id="gearCountLabel" layoutX="312.0" layoutY="17.0" styleClass="label-value" />

                <Label fx:id="currentGearLabel" layoutX="23.0" layoutY="56.0" prefHeight="28.0" prefWidth="3.0" styleClass="parameters" />

                <HBox layoutX="9.0" layoutY="115.0" spacing="8" styleClass="controls-box">
                    <Button fx:id="shiftUpButton" onAction="#shiftUp" styleClass="buttonOne" text="▲ SHIFT UP" />
                    <Button fx:id="shiftDownButton" onAction="#shiftDown" styleClass="buttonTwo" text="▼ SHIFT DOWN" />
                </HBox>
            </Pane>

            <Pane prefHeight="148.0" prefWidth="402.0" styleClass="panel">
                <Label layoutX="7.0" layoutY="2.0" styleClass="section-name" text="CLUTCH" />

                <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="NAME" />
                <Label fx:id="clutchNameLabel" layoutX="11" layoutY="53.0" styleClass="label-value" />

                <Label layoutX="157.0" layoutY="33.0" styleClass="label-header" text="PRICE" />
                <Label fx:id="clutchPriceLabel" layoutX="157" layoutY="53" styleClass="label-value" />

                <Label layoutX="253.0" layoutY="33.0" styleClass="label-header" text="WEIGHT" />
                <Label fx:id="clutchWeightLabel" layoutX="253" layoutY="53" styleClass="label-value" />

                <HBox layoutX="9.0" layoutY="77.0" spacing="8" styleClass="controls-box">
                    <ToggleButton fx:id="pressClutchButton" onAction="#pressClutch" styleClass="buttonOne" text="PRESS">
                        <toggleGroup>
                            <ToggleGroup fx:id="clutchStateGroup" />
                        </toggleGroup>
                    </ToggleButton>
                    <ToggleButton fx:id="releaseClutchButton" onAction="#releaseClutch" styleClass="buttonTwo" text="RELEASE" toggleGroup="$clutchStateGroup" />
                </HBox>
            </Pane>

        </VBox>
    </left>

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <Label styleClass="app-title" text="CAR SIMULATOR" />
            <Pane styleClass="divider" />

            <Label styleClass="top-label" text="Car" />
            <ComboBox fx:id="selectCarComboBox" prefWidth="160" />

            <Button fx:id="addCarButton" onAction="#openAddCarWindow" styleClass="buttonOne" text="Add Car" />
            <Button fx:id="removeCarButton" onAction="#onCarDeleteButton" styleClass="buttonTwo" text="Remove Car" />

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#minimizeApp" styleClass="button-menu" text="—" />
            <Button onAction="#maximizeApp" styleClass="button-menu" text="□" />
            <Button onAction="#closeApp" styleClass="button-menu" text="✕" />
        </HBox>
    </top>

    <center>
        <AnchorPane fx:id="map" prefHeight="757.0" prefWidth="496.0">
            <ImageView fx:id="carImageView" />

            <Pane AnchorPane.rightAnchor="12" AnchorPane.topAnchor="12">
                <styleClass>
                    <String fx:value="panel" />
                    <String fx:value="position-box" />
                </styleClass>
                <Label layoutX="7.0" layoutY="11.0" styleClass="label-header" text="POSITION" />
                <Label fx:id="positionXLabel" layoutX="7.0" layoutY="23.0" styleClass="label-value" />
                <Label fx:id="positionYLabel" layoutX="7.0" layoutY="33.0" styleClass="label-value" />
            </Pane>
        </AnchorPane>
    </center>

</BorderPane>
