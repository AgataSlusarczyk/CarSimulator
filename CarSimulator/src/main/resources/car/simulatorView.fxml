<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="900.0" prefWidth="1551.0" style="-fx-background-color: #171616" stylesheets="@css/simulatorView.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="car.app.CarSimulatorController">

    <left>
        <VBox prefHeight="766.0" prefWidth="404.0" BorderPane.alignment="CENTER">
            <children>
                <Pane prefHeight="203.0" prefWidth="404.0" styleClass="panel">
                    <children>
                        <Label layoutY="7.0" lineSpacing="2.0" styleClass="section-name" text="CAR" />

                        <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="Brand" />
                        <Label fx:id="brandLabel" layoutX="11.0" layoutY="53.0" styleClass="label-value" />

                        <Label layoutX="142.0" layoutY="33.0" styleClass="label-header" text="Model" />
                        <Label fx:id="modelLabel" layoutX="139.0" layoutY="53.0" styleClass="label-value" />

                        <Label layoutX="11.0" layoutY="83.0" styleClass="label-header" text="Plate" />
                        <Label fx:id="licensePlateLabel" layoutX="11.0" layoutY="103.0" styleClass="label-value" />

                        <Label layoutX="142.0" layoutY="83.0" styleClass="label-header" text="Weight" />
                        <Label fx:id="carWeightLabel" layoutX="139.0" layoutY="103.0" styleClass="label-value" />

                        <HBox layoutX="14.0" layoutY="133.0" prefHeight="37.0" prefWidth="346.0" spacing="8" style="-fx-padding: 10 0 0 0;">
                            <fx:define>
                                <ToggleGroup fx:id="carStateGroup" />
                            </fx:define>
                            <ToggleButton fx:id="startCarButton" mnemonicParsing="false" onAction="#startCar" styleClass="buttonOne" text="▶ START" />
                            <ToggleButton fx:id="stopCarButton" mnemonicParsing="false" onAction="#stopCar" styleClass="buttonTwo" text="■ STOP">
                                <toggleGroup>
                                    <ToggleGroup fx:id="carStateGroup" />
                                </toggleGroup>
                            </ToggleButton>
                        </HBox>

                    </children>
                </Pane>
                <Pane prefHeight="243.0" prefWidth="404.0" styleClass="panel">
                    <Label layoutX="7.0" layoutY="2.0" lineSpacing="2.0" styleClass="section-name" text="ENGINE" />

                    <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="Name" />
                    <Label fx:id="engineNameLabel" layoutX="11.0" layoutY="53.0" styleClass="label-value" />

                    <Label layoutX="142.0" layoutY="33.0" styleClass="label-header" text="Price" />
                    <Label fx:id="enginePriceLabel" layoutX="139.0" layoutY="53.0" styleClass="label-value" />

                    <Label layoutX="11.0" layoutY="83.0" styleClass="label-header" text="Weight" />
                    <Label fx:id="engineWeightLabel" layoutX="11.0" layoutY="103.0" styleClass="label-value" />

                    <VBox alignment="CENTER" layoutX="142.0" layoutY="103.0" spacing="2">
                        <Label fx:id="currentRpmLabel" styleClass="parameters" />
                        <Label style="-fx-font-size: 10; -fx-letter-spacing: 2; -fx-text-fill: #444;" styleClass="label-header" text="RPM" />
                    </VBox>

                    <Label layoutX="312.0" layoutY="17.0" styleClass="label-header" text="MAX:" />
                    <Label fx:id="maxRpmLabel" layoutX="345.0" layoutY="17.0" styleClass="label-value" />


                    <HBox layoutX="14.0" layoutY="173.0" prefHeight="66.0" prefWidth="333.0" spacing="8" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="increaseRpmButton" layoutY="15.0" onAction="#increaseRpm" styleClass="buttonOne" text="▲ INCREASE" textAlignment="CENTER" />
                        <Button fx:id="decreaseRpmButton" layoutY="15.0" mnemonicParsing="false" onAction="#decreaseRpm" styleClass="buttonTwo" text="▼ DECREASE" textAlignment="CENTER" />
                    </HBox>
                </Pane>
                <Pane prefHeight="181.0" prefWidth="404.0" styleClass="panel">
                    <Label layoutX="7.0" layoutY="2.0" lineSpacing="2.0" styleClass="section-name" text="GEAR BOX" />

                    <Label layoutX="71.0" layoutY="32.0" styleClass="label-header" text="NAME" />
                    <Label fx:id="gearBoxNameLabel" layoutX="171.0" layoutY="14.0" styleClass="label-value" />

                    <Label layoutX="227.0" layoutY="55.0" styleClass="label-header" text="PRICE" />
                    <Label fx:id="gearBoxPriceLabel" layoutX="171.0" layoutY="44.0" styleClass="label-value" />

                    <Label layoutX="71.0" layoutY="83.0" styleClass="label-header" text="WEIGHT" />
                    <Label fx:id="gearBoxWeightLabel" layoutX="171.0" layoutY="74.0" styleClass="label-value" />

                    <Label layoutX="322.0" layoutY="17.0" styleClass="label-header" text="GEARS" />
                    <Label fx:id="gearCountLabel" layoutX="312.0" layoutY="17.0" styleClass="label-value" />

                    <Label fx:id="currentGearLabel" layoutX="20" layoutY="36.0" styleClass="parameters" />

                    <HBox layoutX="9.0" layoutY="115.0" prefHeight="66.0" prefWidth="386.0" spacing="8" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="shiftUpButton" layoutX="56.0" layoutY="78.0" mnemonicParsing="false" onAction="#shiftUp" styleClass="buttonOne" text="▲ SHIFT UP" />
                        <Button fx:id="shiftDownButton" layoutX="189.0" layoutY="78.0" mnemonicParsing="false" onAction="#shiftDown" prefHeight="46.0" prefWidth="148.0" styleClass="buttonTwo" text="▼ SHIFT DOWN" />
                    </HBox>
                </Pane>
                <Pane prefHeight="143.0" prefWidth="404.0" styleClass="panel">
                    <Label layoutX="7.0" layoutY="2.0" lineSpacing="2.0" styleClass="section-name" text="CLUTCH" />

                    <Label layoutX="11.0" layoutY="33.0" styleClass="label-header" text="NAME" />
                    <Label fx:id="clutchNameLabel" layoutX="11" layoutY="53.0" styleClass="label-value" />

                    <Label layoutX="101" layoutY="33" styleClass="label-header" text="PRICE" />
                    <Label fx:id="clutchPriceLabel" layoutX="101" layoutY="53" styleClass="label-value" />

                    <Label layoutX="191" layoutY="33" styleClass="label-header" text="WEIGHT" />
                    <Label fx:id="clutchWeightLabel" layoutX="191" layoutY="53" styleClass="label-value" />

                    <HBox layoutX="9.0" layoutY="77.0" prefHeight="66.0" prefWidth="386.0" spacing="8" style="-fx-padding: 10 0 0 0;">
                        <ToggleButton fx:id="pressClutchButton" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#pressClutch" styleClass="buttonOne" text="PRESS">
                            <toggleGroup>
                                <ToggleGroup fx:id="clutchStateGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="releaseClutchButton" layoutX="253.0" layoutY="14.0" mnemonicParsing="false" onAction="#releaseClutch" styleClass="buttonTwo" text="RELEASE" toggleGroup="$clutchStateGroup" />
                    </HBox>
                </Pane>
            </children>
        </VBox>
    </left>
    <top>
        <AnchorPane prefHeight="34.0" prefWidth="951.0" BorderPane.alignment="CENTER">
            <ComboBox fx:id="selectCarComboBox" layoutX="103.0" layoutY="1.0" prefWidth="150.0" />
            <Label layoutX="6.0" layoutY="7.0" prefHeight="18.0" prefWidth="73.0" text="Car">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <Button fx:id="addCarButton" layoutX="381.0" layoutY="5.0" mnemonicParsing="false" onAction="#openAddCarWindow" text="Add Car" />
            <Button fx:id="removeCarButton" layoutX="524.0" layoutY="5.0" mnemonicParsing="false" onAction="#onCarDeleteButton" text="Remove Car" />
        </AnchorPane>
    </top>
    <center>
        <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">

            <Pane fx:id="map" BorderPane.alignment="CENTER">
                <ImageView fx:id="carImageView" />
            </Pane>
            <center>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="216.0" prefWidth="330.0" BorderPane.alignment="CENTER">
                    <Label layoutX="14.0" layoutY="96.0" prefHeight="66.0" prefWidth="138.0" text="Current Position">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label fx:id="positionXLabel" layoutX="171.0" layoutY="107.0">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label fx:id="positionYLabel" layoutX="171.0" layoutY="137.0">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label layoutX="152.0" layoutY="107.0" prefHeight="18.0" prefWidth="138.0" text="X">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label layoutX="152.0" layoutY="137.0" prefHeight="18.0" prefWidth="138.0" text="Y">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                </AnchorPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>